DB_HOST="YOUR_DB_HOST"
DB_PORT="YOUR_DB_PORT"
DB_NAME="YOUR_DB_NAME"
DB_USER="YOUR_DB_USER"
DB_PASSWORD="YOUR_DB_PASSWORD"
DB_SSL="YOUR_DB_SSL"

JWT_SECRET_KEY = "YOUR_JWT_SECRET_KEY"
JWT_EXPIRES_IN="YOUR_JWT_EXPIRES_IN"
JWT_API_KEY_EXPIRES_IN = "YOUR_JWT_API_KEY_EXPIRES_IN"

STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

STRIPE_PRICE_ID_BASICO="YOUR_STRIPE_PRICE_ID_BASICO"
STRIPE_PRICE_ID_PREMIUM="YOUR_STRIPE_PRICE_ID_PREMIUM"
# Price $500 anticipo (Checkout mode=payment). Dashboard: activar checkout.session.completed.
STRIPE_PRICE_ID_SETUP="YOUR_STRIPE_PRICE_ID_SETUP"

# Fleet crypto via gRPC Backend (Encrypt/Decrypt). Keys viven solo en Backend.
# BACKEND_GRPC_URL / GRPC_HMAC_SECRET más abajo.

LIMIT_PER_PAGE=6

EMAIL_USER="YOUR_EMAIL_USER"
EMAIL_PASSWORD="YOUR_EMAIL_PASSWORD"
# Alertas internas (pago fallido + anticipo $500 de alta). Mismos destinatarios.
EMAIL_TO1="YOUR_INTERNAL_ALERT_EMAIL_1"
EMAIL_TO2="YOUR_INTERNAL_ALERT_EMAIL_2"

# Fly/prod (secret, no el workflow): solo https://passmanager.reservai.com.mx
# Local puede listar localhost.
# Local compose UI: http://localhost:8080
CORS_ORIGIN="YOUR_CORS_ORIGIN"
CORS_CREDENTIALS="YOUR_CORS_CREDENTIALS"

APIKEY_ADMIN = "YOUR_APIKEY_ADMIN"
APIKEY_ID_ADMIN="YOUR_APIKEY_ID_ADMIN"

APIKEY_CLIENT = "YOUR_APIKEY_CLIENT"
APIKEY_ID_CLIENT="YOUR_APIKEY_ID_CLIENT"

SENTRY_DSN="YOUR_SENTRY_DSN"
SENTRY_SERVICE_NAME="StripeService"
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Secreto compartido con reservAI_gateway (header X-Proxy-Secret).
# Debe coincidir con PROXY_SECRET_HEADER del gateway y del backend PassManager.
# También exige en /webhooks/stripe (nginx lo inyecta; Stripe CLI → :8080, no :3001).
# Obligatorio en production. Generar: openssl rand -hex 32
PROXY_SECRET_HEADER="change_me_proxy_secret"
# PROXY_SECRET_HEADER_NAME=x-proxy-secret

RATE_LIMIT_MAX_REQUESTS=70
RATE_LIMIT_WINDOW_MS=900000

# Local compose: http://api:8000/webhooks/payment (KBS en reservai_internal)
# Production: vacío → https://knowledge.{subdomain}.reservai.com.mx/webhooks/payment
PAYMENT_FANOUT_URL=http://api:8000/webhooks/payment

# Worker VPS (HMAC). Local compose: http://provision:3003/jobs
PROVISION_WORKER_URL=http://provision:3003/jobs
PROVISION_SECRET_KEY=change_me_provision_hmac

# --- Supabase Storage (service role; solo backend) ---
# Crear el bucket privado en el proyecto (Dashboard → Storage).
# Las descargas van firmadas o por proxy del API de billing.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_INVOICES_BUCKET="billing-invoices"

# --- Facturama API Web (Basic Auth; un RFC emisor) ---
FACTURAMA_USER="YOUR_FACTURAMA_USER"
FACTURAMA_PASSWORD="YOUR_FACTURAMA_PASSWORD"
# Sandbox: https://apisandbox.facturama.mx  |  Prod: https://api.facturama.mx
# En sandbox, POST /customers/validate no valida RFCs reales (solo de prueba, p.ej. EKU9003173C9).
# FACTURAMA_SAT_VALIDATE_STRICT=true fuerza rechazo estricto también en sandbox.
FACTURAMA_BASE_URL="https://apisandbox.facturama.mx"
# CP del EMISOR (ReservAI) registrado en Facturama → Perfil fiscal → Lugares de expedición.
# No uses el CP del cliente/receptor. Debe coincidir exactamente con un lugar de expedición activo.
FACTURAMA_EXPEDITION_PLACE="YOUR_CP_EMISION"
FACTURAMA_PAYMENT_FORM="03"
FACTURAMA_PRODUCT_CODE="81112100"
FACTURAMA_UNIT_CODE="E48"

# gRPC VaultProvision: CreatePasswords + Encrypt + Decrypt (fleet).
# Mismo GRPC_HMAC_SECRET que Backend / VPS / Monitor. No reutilizar PROVISION_SECRET_KEY.
BACKEND_GRPC_URL=passmanager-backend-service.flycast:50051
GRPC_HMAC_SECRET=change_me_grpc_hmac
BASE_DOMAIN=reservai.com.mx

# ---------------------------------------------------------------------------
# Setup blob (Stripe → technical_info.encrypted_setup_json → VPS Bootstrap)
# VPS ya no lee RESERVAI_SETUP_CONSTANTS ni OPENAI_API_KEY ni setup.shared.json.
# Estas vars se embeben en el plaintext del blob junto con secretos del tenant.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
# JSON de organización. Debe incluir al menos: ssl_email, chatwoot_super_admin_email,
# chatwoot_crm_admin_email, admin_email, google_client_id, google_client_secret,
# oauth_client_secret, minio_root_user. Opcional: SMTP / WhatsApp / Sentry (antes en setup.shared).
RESERVAI_SETUP_CONSTANTS={"ssl_email":"support@reservai.com.mx","chatwoot_super_admin_email":"admin@reservai.com.mx","chatwoot_crm_admin_email":"crm@reservai.com.mx","admin_email":"admin@reservai.com.mx","google_client_id":"YOUR_GOOGLE_CLIENT_ID","google_client_secret":"YOUR_GOOGLE_CLIENT_SECRET","oauth_client_secret":"YOUR_OAUTH_KB_CLIENT_SECRET","minio_root_user":"root","whatsapp_app_id":"YOUR_WA_APP_ID","whatsapp_configuration_id":"YOUR_WA_CONFIG_ID","whatsapp_app_secret":"YOUR_WA_APP_SECRET","whatsapp_api_version":"v22.0","smtp_host":"smtp.example.com","smtp_port":465,"smtp_user":"support@example.com","smtp_password":"YOUR_SMTP_PASSWORD","smtp_from":"support@example.com","smtp_use_tls":true,"sentry_dsn":"YOUR_SENTRY_DSN"}
