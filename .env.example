DB_HOST="YOUR_DB_HOST"
DB_PORT="YOUR_DB_PORT"
DB_NAME="YOUR_DB_NAME"
DB_USER="YOUR_DB_USER"
DB_PASSWORD="YOUR_DB_PASSWORD"
DB_SSL="YOUR_DB_SSL"

JWT_SECRET_KEY = "YOUR_JWT_SECRET_KEY"
JWT_EXPIRES_IN="YOUR_JWT_EXPIRES_IN"
JWT_API_KEY_EXPIRES_IN = "YOUR_JWT_API_KEY_EXPIRES_IN"

STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

STRIPE_PRICE_ID_BASICO="YOUR_STRIPE_PRICE_ID_BASICO"
STRIPE_PRICE_ID_PREMIUM="YOUR_STRIPE_PRICE_ID_PREMIUM"
# Price $500 anticipo (Checkout mode=payment). Dashboard: activar checkout.session.completed.
STRIPE_PRICE_ID_SETUP="YOUR_STRIPE_PRICE_ID_SETUP"

# Mismas claves GCM que PassManager (inbound_auth_key).
VAULT_MASTER_KEYS='[{"keyId":"v1","keyBase64":"YOUR_32_BYTE_KEY_BASE64"}]'
VAULT_ACTIVE_KEY_ID="v1"

LIMIT_PER_PAGE=6

EMAIL_USER="YOUR_EMAIL_USER"
EMAIL_PASSWORD="YOUR_EMAIL_PASSWORD"
# Alertas internas (pago fallido + anticipo $500 de alta). Mismos destinatarios.
EMAIL_TO1="YOUR_INTERNAL_ALERT_EMAIL_1"
EMAIL_TO2="YOUR_INTERNAL_ALERT_EMAIL_2"

# Fly/prod (secret, no el workflow): solo https://passmanager.reservai.com.mx
# Local puede listar localhost.
# Local compose UI: http://localhost:8080
CORS_ORIGIN="YOUR_CORS_ORIGIN"
CORS_CREDENTIALS="YOUR_CORS_CREDENTIALS"

APIKEY_ADMIN = "YOUR_APIKEY_ADMIN"
APIKEY_ID_ADMIN="YOUR_APIKEY_ID_ADMIN"

APIKEY_CLIENT = "YOUR_APIKEY_CLIENT"
APIKEY_ID_CLIENT="YOUR_APIKEY_ID_CLIENT"

SENTRY_DSN="YOUR_SENTRY_DSN"
SENTRY_SERVICE_NAME="StripeService"
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Secreto compartido con reservAI_gateway (header X-Proxy-Secret).
# Debe coincidir con PROXY_SECRET_HEADER del gateway y del backend PassManager.
# Obligatorio en production. Generar: openssl rand -hex 32
PROXY_SECRET_HEADER="change_me_proxy_secret"
# PROXY_SECRET_HEADER_NAME=x-proxy-secret

RATE_LIMIT_MAX_REQUESTS=70
RATE_LIMIT_WINDOW_MS=900000

# Local compose: http://api:8000/webhooks/payment (KBS en reservai_internal)
# Production: vacío → https://knowledge.{subdomain}.reservai.com.mx/webhooks/payment
PAYMENT_FANOUT_URL=http://api:8000/webhooks/payment

# Worker VPS (HMAC). Local compose: http://provision:3003/jobs
PROVISION_WORKER_URL=http://provision:3003/jobs
PROVISION_SECRET_KEY=change_me_provision_hmac
